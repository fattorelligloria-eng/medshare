# Copie para .env.production antes do build que vai para o Firebase Hosting.
# O .env.production nunca vai para o Git.
#
# Endereço público da API, sem barra no fim. O painel chama <endereço>/api/...
# Lembre de pôr o domínio do Hosting em MEDSHARE_CORS_ORIGENS na API, por ex.:
#   MEDSHARE_CORS_ORIGENS=https://medshare.web.app,https://medshare.firebaseapp.com
#
# Em branco, o painel chama "/api" no mesmo domínio (desenvolvimento, ou API no
# Cloud Run ligada por rewrite no firebase.json).
VITE_MEDSHARE_API=
