# Copie para .env e preencha. O .env nunca vai para o Git.

MEDSHARE_BANCO_URL=jdbc:postgresql://localhost:5432/medshare
MEDSHARE_BANCO_USUARIO=medshare
MEDSHARE_BANCO_SENHA=medshare_local

# Chave de assinatura do JWT. Gere a sua com:
#   openssl rand -base64 48
MEDSHARE_JWT_SEGREDO=troque-esta-chave-por-uma-gerada-com-openssl-rand-base64-48

# Gemini (pré-validação da foto). Pegue em https://aistudio.google.com/apikey
MEDSHARE_GEMINI_CHAVE=

# Cloudflare R2 (fotos)
MEDSHARE_R2_ENDPOINT=
MEDSHARE_R2_BUCKET=medshare-fotos
MEDSHARE_R2_CHAVE_ID=
MEDSHARE_R2_CHAVE_SECRETA=

# Portal da Transparência — consulta do NIS (RN08).
# Grátis: cadastre um e-mail em portaldatransparencia.gov.br/api-de-dados
# Sem ela, todo NIS válido vai para conferência da central.
MEDSHARE_PORTAL_CHAVE=
