# Copie para .env e preencha. O .env nunca vai para o Git.

# Porta da API. Troque se a 8080 já estiver ocupada na sua máquina.
MEDSHARE_PORTA=8080

# Banco. Se você já tem um Postgres instalado segurando a 5432, troque as duas
# linhas abaixo para 5433 — o Docker Compose e a API leem as duas daqui, e
# nenhum arquivo versionado precisa ser alterado.
MEDSHARE_BANCO_PORTA=5432
MEDSHARE_BANCO_URL=jdbc:postgresql://localhost:5432/medshare
MEDSHARE_BANCO_USUARIO=medshare
MEDSHARE_BANCO_SENHA=medshare_local

# Chave de assinatura do JWT. Gere a sua com:
#   openssl rand -base64 48
MEDSHARE_JWT_SEGREDO=troque-esta-chave-por-uma-gerada-com-openssl-rand-base64-48

# Gemini (pré-validação da foto: lote, validade e lacre). Chave gratuita em
# https://aistudio.google.com/apikey — no plano gratuito o Google pode usar as
# fotos enviadas; por isso só a foto da embalagem vai, nunca a da receita.
# Em branco, toda doação vai direto para a central.
MEDSHARE_GEMINI_CHAVE=
# MEDSHARE_GEMINI_MODELO=gemini-3.8-flash

# Fotos. O endereço público precisa ser o que o celular alcança (o IP da sua
# máquina na rede, não "localhost"). Só fotos com este endereço são aceitas.
MEDSHARE_FOTOS_DIRETORIO=./dados/fotos
MEDSHARE_FOTOS_ENDERECO=http://localhost:8080/fotos-locais

# Catálogo de medicamentos (RN07). Baixe o "PMC - xls" em
# gov.br/anvisa > Medicamentos > CMED > Preços, salve em dados/cmed/ e aponte
# aqui. A API importa ao subir; a lista sai todo mês, e reimportar só atualiza.
MEDSHARE_CMED_ARQUIVO=

# Portal da Transparência — consulta do NIS (RN08).
# Grátis: cadastre um e-mail em portaldatransparencia.gov.br/api-de-dados
# Sem ela, todo NIS válido vai para conferência da central.
MEDSHARE_PORTAL_CHAVE=
